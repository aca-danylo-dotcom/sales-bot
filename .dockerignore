# Что не должно уехать в образ на хостинг.

# Секреты: на хостинге они задаются переменными окружения, а не файлом.
.env

# Локальные данные: база и фото на сервере лежат на постоянном диске.
*.db
*.db-journal
*.db-wal
*.db-shm
*.db.bak-*
media/

# Панель собирается внутри образа, первой ступенью. Локальные node_modules —
# это сотни мегабайт и чужая платформа: в контекст сборки им незачем.
web/frontend/node_modules/
web/dist/

.venv/
venv/
__pycache__/
*.pyc
*.pyo
.mypy_cache/
.pytest_cache/

.git/
.gitignore
*.log
