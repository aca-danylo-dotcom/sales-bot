# Скопируйте этот файл в .env и заполните значения.

# Токен бота от @BotFather (команда /newbot)
BOT_TOKEN=123456789:AA...ваш_токен...

# Ваш личный Telegram ID (узнать через @userinfobot) — по нему бот отличает админа
ADMIN_ID=123456789

# ИИ-консультант: Claude от Anthropic.
# Ключ заводится на https://console.anthropic.com/settings/keys (вид sk-ant-api...),
# баланс пополняется там же в разделе Billing. Кончились деньги — бот отвечает
# «технический перерыв», а в логе пишет причину прямым текстом.
ANTHROPIC_API_KEY=sk-ant-api...ваш_ключ...
# Модель. Haiku 4.5 — быстрая и дешёвая, для магазина её хватает. Умнее и вдвое
# дороже — claude-sonnet-5.
AI_MODEL=claude-haiku-4-5
# Цены модели за миллион токенов — из них считается себестоимость ответа для
# дашборда статистики. Значения ниже — для Haiku 4.5; меняете модель, меняйте и
# их, иначе расход в отчётах превратится в выдумку.
AI_PRICE_IN=1
AI_PRICE_OUT=5
# Защита от накрутки расходов: сколько платных запросов к модели допускается за
# сутки. На одного клиента — живой покупатель пишет десятки сообщений, не сотни.
AI_DAILY_PER_CLIENT=150
# На весь бот. Упёршись в этот потолок, бот перестаёт отвечать всем до полуночи
# и пишет об этом владельцу — ставьте с запасом к обычному дню магазина.
AI_DAILY_TOTAL=3000

# --- Витрина магазина. Единственный блок, который уходит в промпт ИИ. ---
SHOP_NAME=Sport Store
SHOP_CITY=Киев
SHOP_CURRENCY=грн
DELIVERY_INFO=Новой Почтой по всей Украине, отправка на следующий рабочий день после оплаты.
PAYMENT_INFO=Предоплата на карту — реквизиты бот присылает при оформлении заказа.
RETURN_INFO=Обмен и возврат в течение 14 дней, если товар не был в использовании.

# --- Оплата. Реквизиты подставляет код при оформлении, ИИ их не видит. ---
PAYMENT_CARD=5375 4141 0000 1234
PAYMENT_CARD_HOLDER=IVAN PETRENKO

# --- Оплата картой прямо в Telegram (по желанию) ---
# Токен выдаёт BotFather: /mybots → ваш бот → Payments → выбрать провайдера.
# Пока строка пустая, всё работает по-старому: бот присылает реквизиты карты и
# кнопку «Я оплатил», владелец сверяет поступление руками. С токеном человек
# платит картой в окне Telegram, а заказ подтверждается сам — сверять нечего.
# PAYMENT_PROVIDER_TOKEN=
# Валюта счёта кодом ISO 4217 (UAH, USD, EUR). Это НЕ подпись «грн» из
# SHOP_CURRENCY: её показывают человеку, а код принимает Telegram.
PAYMENT_CURRENCY_CODE=UAH
# Сколько часов заказ ждёт оплаты. Потом отменяется, товар возвращается на склад.
ORDER_PAYMENT_TIMEOUT_HOURS=24
# Через сколько часов простоя напомнить о брошенной корзине. Напоминание одно.
CART_REMINDER_HOURS=6

# --- Скидка в напоминаниях ---
# Промокод именной и одноразовый: выписывается конкретному человеку вместе с
# напоминанием и работает только у него. Клиент присылает код в чат, скидка
# считается при оформлении заказа.
# PROMO_PERCENT=0 полностью выключает скидки — напоминания будут уходить без них.
PROMO_PERCENT=5
# Сколько дней живёт код.
PROMO_TTL_DAYS=3

# --- Напоминание тем, кто давно не заходил ---
# Человек говорил с ботом, ничего не купил и пропал. Пишем ему один раз.
WINBACK_ENABLED=1
# Через сколько дней тишины считаем клиента «уснувшим».
WINBACK_AFTER_DAYS=14
# Минимальная пауза между любыми нашими напоминаниями одному человеку.
WINBACK_COOLDOWN_DAYS=30
# Сколько сообщений за один проход задачи (защита от веерной рассылки).
WINBACK_BATCH=20

# --- Почта (SMTP) ---
# Второй канал напоминаний. Адрес клиент оставляет САМ и по желанию — при
# оформлении заказа или командой /email. Пустой SMTP_HOST выключает письма
# целиком, бот при этом работает как обычно и пишет только в Telegram.
# Пример для Gmail: smtp.gmail.com, порт 587, пароль приложения (не от аккаунта).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Отправитель. Пустой SMTP_FROM — берётся SMTP_USER, имя — название магазина.
SMTP_FROM=
SMTP_FROM_NAME=
# 1 — сразу SSL (обычно порт 465). Пусто — определяется по порту: 465 → SSL,
# остальные → STARTTLS.
SMTP_SSL=

# --- Веб-CRM ---
# ВНИМАНИЕ: без CRM_PASSWORD (ниже) панель открыта всем, кто знает адрес, —
# вместе с заказами, телефонами и адресами клиентов. На хостинге задайте пароль.
#
# Пароль на вход с компьютера. Внутри Telegram он не спрашивается: там владельца
# опознаёт сам мессенджер по подписи, и в панель пускают только ADMIN_ID.
# Пустое значение оставляет панель открытой — удобно на своём ПК, недопустимо в
# интернете: адреса вида *.up.railway.app находят перебором.
# CRM_PASSWORD=придумайте-длинный-пароль
# Сколько дней панель помнит вход. По умолчанию 30.
# CRM_SESSION_DAYS=30

# Порт панели на своём ПК. На хостинге порт приходит в PORT и эта строка не нужна.
WEB_PORT=8080
# На своём ПК поставьте 127.0.0.1, чтобы панель открывалась только с этого
# компьютера. На хостинге не задавайте: там нужен 0.0.0.0, иначе он не достучится.
# WEB_HOST=127.0.0.1

# --- Мини-приложение в Telegram ---
# Адрес, по которому открывается витрина, — тот же, где висит панель. Telegram
# принимает ТОЛЬКО https и настоящий домен: localhost и http он не откроет.
#
# Пока строка пустая, кнопок магазина в боте нет и всё идёт перепиской. Как
# только адрес задан, витрина появляется двумя кнопками сразу: в меню под полем
# ввода и на кнопке слева от него.
#
# Кто открыл приложение, сервер узнаёт от самого Telegram по подписи, поэтому
# витрина достаётся покупателю, а панель — только ADMIN_ID. Вход с компьютера
# это не меняет: там по-прежнему спрашивается CRM_PASSWORD.
# WEBAPP_URL=https://ваш-домен

# Часовой пояс магазина — по нему считаются заказы, таймауты и напоминания,
# НЕЗАВИСИМО от часов компьютера, где запущен бот. По умолчанию Киев.
TIMEZONE=Europe/Kiev

# Файлы (обычно менять не нужно)
DB_FILE=shop.db

# ТОЛЬКО ДЛЯ ХОСТИНГА. На своём ПК эти переменные не задаются.
# DB_PATH — абсолютный путь к базе на постоянном диске. Без него база легла бы
# рядом с кодом, а код на хостинге разворачивается заново при каждом обновлении,
# то есть товары и заказы пропадали бы. Пример для диска в /data:
# DB_PATH=/data/shop.db
# MEDIA_DIR — папка с фото товаров. По умолчанию рядом с базой, менять не нужно.
# MEDIA_DIR=/data/media
# DB_SEED_GZ_B64 — разовый перенос существующей базы на новый пустой диск:
# содержимое shop.db, сжатое gzip и закодированное base64. Разворачивается ТОЛЬКО
# если по DB_PATH ещё нет файла. После первого успешного запуска можно удалить.
# DB_SEED_GZ_B64=

# Google Sheets через Apps Script Web App (настройка — docs/GOOGLE_SHEETS.md).
# Оставьте пустыми, чтобы выгрузка была выключена — бот работает и без неё.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_TOKEN=

# Дашборд статистики Agent Stats: адрес сайта и ключ агента (заводится в админке
# статистики). Оставьте пустыми — отчёт выключен, бот работает как раньше.
AGENT_STATS_URL=
AGENT_STATS_KEY=
# Сколько ждать ответ сайта статистики, секунд. Ответ клиенту этого не ждёт.
AGENT_STATS_TIMEOUT=5

