.venv/
venv/

# Python
__pycache__/
*.pyc
*.pyo
.mypy_cache/
.pytest_cache/

# Фронтенд: исходники в репозитории, сборка — нет. web/dist собирает Docker
# (см. Dockerfile), и держать её в git значило бы коммитить одно и то же
# приложение дважды — в виде кода и в виде минифицированной копии.
web/dist/
node_modules/
# Кэш сборщика и папка «@» — след от shadcn CLI: он принял алиас «@/...» за
# имя каталога и создал его буквально. К проекту отношения не имеет.
web/frontend/.vite/
web/frontend/@/
# Сборка проверочного прогона страниц (check-render.tsx) — временная.
web/frontend/ssr-check/
