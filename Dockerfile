# Образ для хостинга. Версия Python закреплена намеренно: она та же, на которой
# бот проверен на компьютере владельца (3.14). Автоопределение версии хостингом
# дало бы другую — и разбираться, почему «локально работало», пришлось бы уже на
# боевом сервере.

# Первая ступень собирает панель. Node нужен только здесь: в готовый образ
# уезжает статика, а не сборщик с node_modules — сервер как отдавал файлы
# питоном, так и отдаёт, и процесс на хостинге по-прежнему один.
FROM node:22-alpine AS frontend
WORKDIR /build

# Зависимости отдельным слоем: правка кода панели не заставляет ставить их
# заново. `npm ci` вместо install — берёт ровно то, что в package-lock.json.
COPY web/frontend/package.json web/frontend/package-lock.json ./
RUN npm ci

COPY web/frontend ./
RUN npm run build

FROM python:3.14-slim

# Логи должны попадать в консоль хостинга сразу, а не копиться в буфере: иначе
# при перезапуске последние строки — как раз те, что объясняют падение, —
# пропадают вместе с процессом.
ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Зависимости отдельным слоем: правка кода не заставляет ставить их заново,
# и обычный деплой занимает секунды вместо минут.
COPY requirements.txt .
RUN pip install -r requirements.txt

COPY . .

# Собранная панель. Каталог web/dist в репозитории не хранится (он в .gitignore)
# — сюда он приезжает из первой ступени. Vite кладёт сборку рядом с исходниками
# (outDir = ../dist), то есть в /dist первой ступени.
COPY --from=frontend /dist ./web/dist

# База и фото живут НЕ здесь, а на постоянном диске — путь задаётся переменной
# DB_PATH (см. docs/DEPLOY.md). Всё, что попадёт в /app, пропадёт при следующем
# обновлении кода.
CMD ["python", "bot.py"]
